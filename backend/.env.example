# Copy this template to backend/.env and configure it locally.
# Never commit real API keys or put them in frontend code.

# Optional AI provider: gemini or anthropic.
# No automatic provider fallback.
FINZORIA_AI_PROVIDER=gemini

# Set credentials and a model available to your provider account.
FINZORIA_GEMINI_API_KEY=
FINZORIA_GEMINI_MODEL=
FINZORIA_ANTHROPIC_API_KEY=
FINZORIA_ANTHROPIC_MODEL=

# Optional local request limits.
# These do not replace provider quotas.
# FINZORIA_AI_REQUESTS_PER_MINUTE=5
# FINZORIA_AI_REQUESTS_PER_DAY=20
# FINZORIA_AI_REQUESTS_PER_TURN=4

# Optional database location, relative to the backend directory.
# FINZORIA_DATABASE_PATH=data/finzoria.sqlite3

# Local development origins.
# FINZORIA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Enable secure cookies when serving the application over HTTPS.
# FINZORIA_COOKIE_SECURE=false
# FINZORIA_SESSION_DAYS=14